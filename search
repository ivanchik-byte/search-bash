def load_config() -> dict:
    cfg = {
        "provider": "gemini",
        "api_key": "",
        "model": "",
        "base_url": "",
        "default_site": "",
        "keys": {},
        "models": {},
    }
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                saved = json.load(f)
                cfg.update(saved)
        except Exception:
            pass

    env_key = os.environ.get("GEMINI_API_KEY") or os.environ.get("OPENROUTER_API_KEY") or os.environ.get("OPENAI_API_KEY")
    if env_key and not cfg.get("api_key"):
        cfg["api_key"] = env_key.strip()
    if os.environ.get("SEARCH_PROVIDER"):
        cfg["provider"] = os.environ.get("SEARCH_PROVIDER").strip()
    if os.environ.get("SEARCH_MODEL"):
        cfg["model"] = os.environ.get("SEARCH_MODEL").strip()

    provider = cfg.get("provider", "gemini")
    p_meta = PROVIDERS.get(provider, PROVIDERS["gemini"])

    if not cfg.get("model"):
        cfg["model"] = cfg.get("models", {}).get(provider) or p_meta["default_model"]
    if not cfg.get("base_url"):
        cfg["base_url"] = p_meta["base_url"]
    if not cfg.get("api_key") and cfg.get("keys", {}).get(provider):
        cfg["api_key"] = cfg["keys"][provider]

    return cfg


def save_config(provider: str = None, api_key: str = None, model: str = None, base_url: str = None, default_site: str = None):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    current = load_config()

    if provider is not None:
        current["provider"] = provider.strip()
    active_p = current.get("provider", "gemini")

    if "keys" not in current:
        current["keys"] = {}
    if "models" not in current:
        current["models"] = {}

    if api_key is not None:
        current["api_key"] = api_key.strip()
        current["keys"][active_p] = api_key.strip()
    if model is not None:
        current["model"] = model.strip()
        current["models"][active_p] = model.strip()
    if base_url is not None:
        current["base_url"] = base_url.strip()
    if default_site is not None:
        current["default_site"] = default_site.strip()

    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(current, f, indent=2, ensure_ascii=False)


def http_request(url: str, method: str = "GET", data: dict = None, headers: dict = None, timeout: float = 30.0) -> dict:
    h = {"User-Agent": f"search-cli/{VERSION}"}
    if headers:
        h.update(headers)
    body = None
    if data is not None:
        body = json.dumps(data).encode("utf-8")
        h["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=body, headers=h, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", errors="replace")
        msg = f"HTTP {e.code}"
        try:
            err_json = json.loads(raw)
            if "error" in err_json:
                err_obj = err_json["error"]
                if isinstance(err_obj, dict) and "message" in err_obj:
                    msg = f"{msg}: {err_obj['message']}"
                else:
                    msg = f"{msg}: {err_obj}"
            else:
                msg = f"{msg}: {raw}"
        except Exception:
            msg = f"{msg}: {raw}"
        raise RuntimeError(msg)
    except Exception as e:
        raise RuntimeError(f"Network error: {e}")


def validate_provider_key(provider: str, api_key: str, base_url: str = None) -> tuple[bool, str]:
    if not base_url:
        base_url = PROVIDERS.get(provider, {}).get("base_url", "")

    try:
        if provider == "gemini":
            url = f"{base_url}/models?key={api_key}"
            data = http_request(url, method="GET", timeout=10.0)
            if "models" in data:
                return True, ""
            return False, "Unexpected response format from Gemini API"
        else:
            url = f"{base_url.rstrip('/')}/models"
            headers = {"Authorization": f"Bearer {api_key}"}
            http_request(url, method="GET", headers=headers, timeout=10.0)
            return True, ""
    except Exception as e:
        return False, str(e)


def prompt_setup() -> dict:
    print("\n=== Search CLI Setup ===")
    print("Select API Provider:")
    print("  [1] Google Gemini (Google AI Studio - 1500 free queries/day)")
    print("  [2] OpenRouter (openrouter.ai - access to 200+ models)")
    print("  [3] Nvidia NIM (integrate.api.nvidia.com - fast LLMs)")
    print("  [4] Custom OpenAI-compatible (Ollama, Groq, vLLM, local server)")

    if not sys.stdin.isatty():
        print("[-] Non-interactive environment. Run 'search --set-key <KEY>'.", file=sys.stderr)
        sys.exit(1)

    choice = input("\nChoice [1-4, default 1]: ").strip()
    p_map = {"1": "gemini", "2": "openrouter", "3": "nvidia", "4": "custom"}
    provider = p_map.get(choice, "gemini")
    p_info = PROVIDERS[provider]

    base_url = p_info["base_url"]
    if provider == "custom":
        url_in = input(f"Enter Base URL [default: {base_url}]: ").strip()
        if url_in:
            base_url = url_in

    if p_info["key_url"]:
        print(f"[*] Get your API key at: {p_info['key_url']}")

    while True:
        try:
            raw_key = input(f"Enter {p_info['name']} API key: ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nAborted.")
            sys.exit(1)

        if not raw_key:
            if provider == "custom":
                raw_key = "none"
                break
            continue

        print(f"[*] Validating key against {p_info['name']}...")
        valid, err = validate_provider_key(provider, raw_key, base_url)
        if not valid:
            print(f"[-] Validation note: {err}")
            save_anyway = input("Do you want to save this key anyway? [y/N]: ").strip().lower()
            if save_anyway == "y":
                break
            retry = input("Try another key? [Y/n]: ").strip().lower()
            if retry == "n":
                sys.exit(1)
            continue

        print(f"[+] Key validated successfully!")
        break

    model = p_info["default_model"]
    model_in = input(f"Model [default: {model}]: ").strip()
    if model_in:
        model = model_in

    save_config(provider=provider, api_key=raw_key, model=model, base_url=base_url)
    print(f"[+] Configuration saved to ~/.config/search/config.json\n")
    return load_config()


def ensure_key() -> dict:
    cfg = load_config()
    if not cfg.get("api_key"):
        return prompt_setup()
    return cfg


def clear_cache() -> int:
    if not CACHE_DIR.exists():
        return 0
    count = 0
    for p in CACHE_DIR.glob("*.json"):
        try:
            p.unlink()
            count += 1
        except Exception:
            pass
    return count


def get_cache(key_str: str) -> dict | None:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    q_hash = hashlib.sha256(key_str.encode("utf-8")).hexdigest()
    cache_file = CACHE_DIR / f"{q_hash}.json"
    if cache_file.exists():
        try:
            with open(cache_file, "r", encoding="utf-8") as f:
                data = json.load(f)
            if time.time() - data.get("timestamp", 0) < CACHE_TTL:
                return data.get("result")
        except Exception:
            pass
    return None


def set_cache(key_str: str, result: dict):
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        q_hash = hashlib.sha256(key_str.encode("utf-8")).hexdigest()
        cache_file = CACHE_DIR / f"{q_hash}.json"
        with open(cache_file, "w", encoding="utf-8") as f:
            json.dump({"timestamp": time.time(), "result": result}, f, ensure_ascii=False)
    except Exception:
        pass


def read_piped_stdin() -> str:
    if sys.stdin.isatty():
        return ""
    try:
        raw_data = sys.stdin.buffer.read(MAX_STDIN_BYTES + 1)
        if len(raw_data) > MAX_STDIN_BYTES:
            print(f"[-] Warning: stdin truncated to {MAX_STDIN_BYTES // 1024 // 1024}MB.", file=sys.stderr)
            raw_data = raw_data[:MAX_STDIN_BYTES]
        return raw_data.decode("utf-8", errors="replace").strip()
    except Exception as e:
        print(f"[-] Warning: failed to read stdin: {e}", file=sys.stderr)
        return ""


def read_file_context(file_path: str) -> str:
    p = Path(file_path).expanduser().resolve()
    if not p.exists() or not p.is_file():
        raise FileNotFoundError(f"File not found: {file_path}")
    size = p.stat().st_size
    if size > MAX_FILE_BYTES:
        raise ValueError(f"File too large ({size // 1024}KB, max {MAX_FILE_BYTES // 1024}KB): {file_path}")
    content = p.read_text(encoding="utf-8", errors="replace")
    return f"File: {p.name}\nPath: {p}\n```\n{content}\n```"


def scan_directory(dir_path: str, max_depth: int = 3, max_files: int = 150) -> str:
    root = Path(dir_path).expanduser().resolve()
    if not root.exists() or not root.is_dir():
        raise FileNotFoundError(f"Directory not found: {dir_path}")

    tree_lines = [f"{root.name}/"]
    file_count = 0
    important_previews = []

    def walk(current: Path, prefix: str, depth: int):
        nonlocal file_count
        if depth > max_depth or file_count >= max_files:
            return

        try:
            entries = sorted(list(current.iterdir()), key=lambda x: (x.is_file(), x.name.lower()))
        except PermissionError:
            return

        visible = [e for e in entries if e.name not in IGNORED_DIRS and not e.name.startswith(".")]

        for idx, entry in enumerate(visible):
            if file_count >= max_files:
                tree_lines.append(f"{prefix}... (limit reached)")
                break

            is_last = idx == len(visible) - 1
            connector = "\\-- " if is_last else "|-- "
            sub_prefix = "    " if is_last else "|   "

            if entry.is_dir():
                tree_lines.append(f"{prefix}{connector}{entry.name}/")
                walk(entry, prefix + sub_prefix, depth + 1)
            else:
                file_count += 1
                tree_lines.append(f"{prefix}{connector}{entry.name}")
                if entry.name.lower() in {
                    "readme.md", "pyproject.toml", "package.json", "cargo.toml",
                    "go.mod", "dockerfile", "docker-compose.yml", "makefile"
                } and len(important_previews) < 2:
                    try:
                        content = entry.read_text(encoding="utf-8", errors="replace")[:1200]
                        important_previews.append(f"--- Preview: {entry.name} ---\n{content}")
                    except Exception:
                        pass

    walk(root, "", 1)

    result = [
        f"Directory Tree ({root}):",
        "\n".join(tree_lines),
        f"\nIndexed files: {file_count}"
    ]
    if important_previews:
        result.append("\n" + "\n\n".join(important_previews))

    return "\n".join(result)


def extract_shell_command(text: str) -> str | None:
    match = re.search(r"```(?:bash|sh|zsh)?\s*\n(.*?)\n```", text, re.DOTALL)
    if match:
        cmd = match.group(1).strip()
        if cmd and not cmd.startswith("#"):
            return cmd
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("$ "):
            return line[2:].strip()
    return None


def call_llm(
    prompt: str,
    cfg: dict,
    model: str = None,
    use_search: bool = True,
    cmd_mode: bool = False,
    site: str = None,
) -> dict:
    provider = cfg.get("provider", "gemini")
    api_key = cfg.get("api_key", "")
    base_url = cfg.get("base_url", "")
    target_model = model or cfg.get("model") or PROVIDERS.get(provider, {}).get("default_model")

    if cmd_mode:
        sys_msg = (
            "You are a precise Linux/Unix command-line assistant. "
            "Output the exact shell command inside a single markdown code block: ```bash\n<command>\n```. "
            "Follow with a concise 1-2 sentence explanation. Avoid introductory filler."
        )
    else:
        sys_msg = (
            "You are a technical CLI assistant for developers and systems engineers. "
            "Provide concise, practical, technical responses with code blocks. "
            "Avoid conversational fluff and emojis."
        )

    augmented_prompt = prompt
    if site:
        augmented_prompt = f"Scope search/knowledge specifically to '{site}'.\n\nQuery: {prompt}"

    if provider == "gemini":
        url = f"{base_url}/models/{target_model}:generateContent?key={api_key}"
        payload = {
            "contents": [{"role": "user", "parts": [{"text": augmented_prompt}]}],
            "systemInstruction": {"parts": [{"text": sys_msg}]},
            "generationConfig": {"temperature": 0.2 if cmd_mode else 0.4, "maxOutputTokens": 3000},
        }
        if use_search:
            payload["tools"] = [{"googleSearch": {}}]

        try:
            data = http_request(url, method="POST", data=payload, timeout=30.0)
        except RuntimeError as e:
            fallback = PROVIDERS["gemini"].get("fallback_model")
            if "HTTP 404" in str(e) and fallback and target_model != fallback:
                print(f"[-] Model '{target_model}' not found. Retrying with '{fallback}'...", file=sys.stderr)
                return call_llm(prompt, cfg, model=fallback, use_search=use_search, cmd_mode=cmd_mode, site=site)
            raise e

        candidates = data.get("candidates", [])
        if not candidates:
            raise RuntimeError("No response candidate returned by Gemini API.")

        parts = candidates[0].get("content", {}).get("parts", [])
        text_parts = [p.get("text", "") for p in parts if "text" in p]
        answer_text = "".join(text_parts).strip()

        grounding_meta = candidates[0].get("groundingMetadata", {})
        queries = grounding_meta.get("webSearchQueries", [])
        chunks = grounding_meta.get("groundingChunks", [])
        sources = []
        seen = set()
        for chunk in chunks:
            web = chunk.get("web", {})
            uri = web.get("uri")
            title = web.get("title", uri)
            if uri and uri not in seen:
                seen.add(uri)
                sources.append({"title": title, "url": uri})

        return {
            "text": answer_text,
            "suggested_cmd": extract_shell_command(answer_text) if cmd_mode else None,
            "queries": queries,
            "sources": sources,
            "model_used": target_model,
        }

    else:
        # OpenAI-compatible (OpenRouter, Nvidia NIM, Ollama, Custom)
        url = f"{base_url.rstrip('/')}/chat/completions"
        headers = {"Authorization": f"Bearer {api_key}"}

        # OpenRouter web search support
        request_model = target_model
        if provider == "openrouter" and use_search and not target_model.endswith(":online"):
            # Can be used with :online suffix on OpenRouter
            pass

        payload = {
            "model": request_model,
            "messages": [
                {"role": "system", "content": sys_msg},
                {"role": "user", "content": augmented_prompt},
            ],
            "temperature": 0.2 if cmd_mode else 0.4,
        }

        data = http_request(url, method="POST", data=payload, headers=headers, timeout=35.0)
        choices = data.get("choices", [])
        if not choices:
            raise RuntimeError(f"No choices returned by {provider} API.")

        answer_text = choices[0].get("message", {}).get("content", "").strip()

        # Extract citations / sources if available
        sources = []
        if "citations" in choices[0]:
            for c in choices[0]["citations"]:
                sources.append({"title": c.get("title", "Source"), "url": c.get("url", "")})

        return {
            "text": answer_text,
            "suggested_cmd": extract_shell_command(answer_text) if cmd_mode else None,
            "queries": [],
            "sources": sources,
            "model_used": target_model,
        }


def execute_shell_command(cmd: str):
    print(f"\n[+] Executing: {cmd}")
    try:
        res = subprocess.run(cmd, shell=True)
        if res.returncode != 0:
            print(f"[-] Command exited with code: {res.returncode}", file=sys.stderr)
    except Exception as e:
        print(f"[-] Execution error: {e}", file=sys.stderr)


def render_output(result: dict, query_str: str, from_cache: bool, target_site: str, no_web: bool, model: str, provider: str):
    if HAS_RICH:
        cache_notice = " [dim](cached)[/dim]" if from_cache else ""
        site_notice = f" [cyan]• site:{target_site}[/cyan]" if target_site else ""
        web_notice = " [green]• web[/green]" if not no_web else " [dim]• no-web[/dim]"
        title = f"[bold white]{query_str or 'Analysis'}[/bold white]{site_notice}{web_notice}{cache_notice}"

        console.print()
        console.print(Panel(
            Markdown(result["text"]),
            title=title,
            border_style="cyan",
            subtitle=f"[dim]{provider} / {result.get('model_used', model)}[/dim]",
            subtitle_align="right",
        ))

        if result.get("sources"):
            console.print("[bold cyan]Sources:[/bold cyan]")
            for idx, s in enumerate(result["sources"][:5], 1):
                console.print(f"  [{idx}] {s['title']}\n      [blue underline]{s['url']}[/blue underline]")
        console.print()
    else:
        border = "=" * 60
        print(f"\n{border}")
        print(f"Results: {query_str or 'Analysis'} ({provider}: {result.get('model_used', model)})")
        print(f"{border}\n")
        print(result["text"])
        if result.get("sources"):
            print("\nSources:")
            for idx, s in enumerate(result["sources"][:5], 1):
                print(f"  [{idx}] {s['title']} -> {s['url']}")
        print()


def run_interactive():
    cfg = ensure_key()
    provider = cfg.get("provider", "gemini")

    if HAS_RICH:
        console.print(Panel(
            f"[bold white]Search CLI[/bold white] [dim]v{VERSION}[/dim]\n"
            f"[dim]Provider: {PROVIDERS.get(provider, {}).get('name', provider)} | Model: {cfg.get('model')}[/dim]",
            border_style="cyan"
        ))
    else:
        print(f"=== Search CLI v{VERSION} ({provider}) ===")

    while True:
        try:
            prompt_str = "\nQuery (or 'q' to exit): "
            query = console.input(f"[bold cyan]{prompt_str}[/bold cyan]").strip() if HAS_RICH else input(prompt_str).strip()
        except (KeyboardInterrupt, EOFError):
            print("\nExiting.")
            break

        if not query or query.lower() in {"q", "exit", "quit"}:
            break

        default_site = cfg.get("default_site", "")
        site_msg = f"Target domain (default: {default_site}): " if default_site else "Target domain (optional, e.g. stackoverflow.com): "
        site_in = (console.input(f"[dim]{site_msg}[/dim]") if HAS_RICH else input(site_msg)).strip()
        target_site = site_in if site_in else default_site

        ctx_msg = "File or dir context (optional, press Enter to skip): "
        ctx_in = (console.input(f"[dim]{ctx_msg}[/dim]") if HAS_RICH else input(ctx_msg)).strip()
        context_data = ""
        if ctx_in:
            ctx_path = Path(ctx_in).expanduser()
            if ctx_path.is_file():
                try:
                    context_data = read_file_context(str(ctx_path))
                except Exception as e:
                    print(f"[-] File error: {e}")
            elif ctx_path.is_dir():
                try:
                    context_data = scan_directory(str(ctx_path))
                except Exception as e:
                    print(f"[-] Directory error: {e}")
            else:
                print(f"[-] Path not found: {ctx_in}")

        mode_msg = "Mode: [1] Search & Explain  [2] Shell Command Generator: "
        mode_in = (console.input(f"[dim]{mode_msg}[/dim]") if HAS_RICH else input(mode_msg)).strip()
        cmd_mode = mode_in == "2"

        full_prompt = query
        if context_data:
            full_prompt = f"Context:\n{context_data}\n\nTask:\n{query}"

        model = cfg.get("model")
        label = "Generating command..." if cmd_mode else f"Querying ({provider}: {model})..."

        try:
            if HAS_RICH:
                with console.status(f"[bold cyan]{label}[/bold cyan]", spinner="dots"):
                    result = call_llm(
                        prompt=full_prompt,
                        cfg=cfg,
                        model=model,
                        use_search=True,
                        cmd_mode=cmd_mode,
                        site=target_site or None,
                    )
            else:
                print(f"[*] {label}")
                result = call_llm(
                    prompt=full_prompt,
                    cfg=cfg,
                    model=model,
                    use_search=True,
                    cmd_mode=cmd_mode,
                    site=target_site or None,
                )
        except Exception as e:
            print(f"[-] API error: {e}")
            continue

        render_output(result, query, False, target_site, False, model, provider)

        suggested_cmd = result.get("suggested_cmd")
        if suggested_cmd and sys.stdin.isatty():
            try:
                choice = input("Execute suggested command? [y/N/e(dit)]: ").strip().lower()
                if choice == "y":
                    execute_shell_command(suggested_cmd)
                elif choice == "e":
                    edited = input("Edit command: ").strip()
                    if edited:
                        execute_shell_command(edited)
            except (KeyboardInterrupt, EOFError):
                pass


def main():
    parser = argparse.ArgumentParser(
        prog="search",
        description="Terminal search, codebase inspection, and multi-provider AI assistant.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  search "how to configure reverse proxy in nginx"
  search -c "find files larger than 50MB and sort by size"
  search -p openrouter -m meta-llama/llama-3.3-70b-instruct "explain b-trees"
  search -p nvidia -m meta/llama-3.3-70b-instruct "optimize cuda kernel"
  search -s stackoverflow.com "python typeerror unhashable type"
  search -f ./nginx.conf "explain ssl configuration"
  search -d . "summarize project architecture"
  cat /var/log/syslog | search "identify root cause"
  search --setup
"""
    )
    parser.add_argument("query", nargs="*", help="Query or prompt to process")
    parser.add_argument("-c", "--cmd", action="store_true", help="Generate an executable shell command")
    parser.add_argument("-p", "--provider", choices=["gemini", "openrouter", "nvidia", "custom"], help="AI provider")
    parser.add_argument("-m", "--model", metavar="NAME", help="Model identifier")
    parser.add_argument("-s", "--site", metavar="DOMAIN", help="Scope search to a specific domain")
    parser.add_argument("-f", "--file", metavar="PATH", help="Attach file content as context")
    parser.add_argument("-d", "--dir", metavar="PATH", help="Attach directory tree and structure as context")
    parser.add_argument("-i", "--interactive", action="store_true", help="Launch interactive wizard/prompt")
    parser.add_argument("-w", "--no-web", action="store_true", help="Disable web search grounding")
    parser.add_argument("-r", "--raw", action="store_true", help="Output plain unformatted text")
    parser.add_argument("-y", "--yes", action="store_true", help="Auto-execute generated command without confirmation")
    parser.add_argument("--setup", action="store_true", help="Run provider and key configuration wizard")
    parser.add_argument("--no-cache", action="store_true", help="Bypass local cache")
    parser.add_argument("--clear-cache", action="store_true", help="Clear local cache")
    parser.add_argument("--set-provider", choices=["gemini", "openrouter", "nvidia", "custom"], help="Set default provider")
    parser.add_argument("--set-key", metavar="KEY", help="Save API key for active provider")
    parser.add_argument("--set-model", metavar="MODEL", help="Save default model for active provider")
    parser.add_argument("--set-url", metavar="URL", help="Save custom Base URL")
    parser.add_argument("--set-site", metavar="DOMAIN", help="Save default search domain")
    parser.add_argument("--force", action="store_true", help="Force save settings even if key validation returns a warning")
    parser.add_argument("-v", "--version", action="version", version=f"%(prog)s {VERSION}")

    args = parser.parse_args()

    if args.setup:
        prompt_setup()
        return

    if args.clear_cache:
        cleared = clear_cache()
        print(f"[+] Cache cleared ({cleared} records removed).")
        return

    if args.set_provider:
        save_config(provider=args.set_provider)
        print(f"[+] Active provider set to: {args.set_provider}")
        return

    if args.set_url:
        save_config(base_url=args.set_url)
        print(f"[+] Base URL set to: {args.set_url}")
        return

    if args.set_model:
        save_config(model=args.set_model)
        print(f"[+] Default model set to: {args.set_model}")
        return

    if args.set_site:
        save_config(default_site=args.set_site)
        print(f"[+] Default search domain set to: {args.set_site}")
        return

    if args.set_key:
        cfg = load_config()
        prov = args.provider or cfg.get("provider", "gemini")
        b_url = args.set_url or cfg.get("base_url")
        valid, err = validate_provider_key(prov, args.set_key, b_url)
        if not valid and not args.force:
            print(f"[-] Key validation failed for {prov}: {err}", file=sys.stderr)
            print("    Use --force to save the key anyway if your network requires a proxy/VPN.", file=sys.stderr)
            sys.exit(1)
        save_config(provider=prov, api_key=args.set_key)
        print(f"[+] API key saved for provider '{prov}'.")
        return

    piped_data = read_piped_stdin()
    query_str = " ".join(args.query).strip()

    if args.interactive or (not query_str and not piped_data):
        if not sys.stdin.isatty():
            parser.print_help()
            sys.exit(0)
        run_interactive()
        return

    cfg = ensure_key()
    if args.provider:
        cfg["provider"] = args.provider
        if not args.model and cfg["provider"] in PROVIDERS:
            cfg["model"] = PROVIDERS[cfg["provider"]]["default_model"]
        if cfg.get("keys", {}).get(args.provider):
            cfg["api_key"] = cfg["keys"][args.provider]

    model = args.model or cfg.get("model")
    provider = cfg.get("provider", "gemini")
    target_site = args.site or cfg.get("default_site", "")

    contexts = []
    if piped_data:
        contexts.append(f"Input Stream / Log:\n```\n{piped_data}\n```")

    if args.file:
        try:
            contexts.append(read_file_context(args.file))
        except Exception as e:
            print(f"[-] File error: {e}", file=sys.stderr)
            sys.exit(1)

    if args.dir:
        try:
            contexts.append(scan_directory(args.dir))
        except Exception as e:
            print(f"[-] Directory error: {e}", file=sys.stderr)
            sys.exit(1)

    if contexts and query_str:
        full_prompt = f"Context:\n" + "\n\n".join(contexts) + f"\n\nRequest:\n{query_str}"
    elif contexts and not query_str:
        full_prompt = (
            "Analyze the provided context data. Identify any errors, warnings, or anomalies, "
            "explain root causes, and provide actionable next steps and commands:\n\n" + "\n\n".join(contexts)
        )
    else:
        full_prompt = query_str

    cache_key = f"{provider}:{model}:{not args.no_web}:{args.cmd}:{target_site}:{full_prompt}"
    from_cache = False
    result = None

    if not args.no_cache:
        cached_result = get_cache(cache_key)
        if cached_result:
            result = cached_result
            from_cache = True

    if result is None:
        use_search = not args.no_web
        status_label = "Generating command..." if args.cmd else f"Querying ({provider}: {model})..."

        try:
            if HAS_RICH and not args.raw:
                with console.status(f"[bold cyan]{status_label}[/bold cyan]", spinner="dots"):
                    result = call_llm(
                        prompt=full_prompt,
                        cfg=cfg,
                        model=model,
                        use_search=use_search,
                        cmd_mode=args.cmd,
                        site=target_site or None,
                    )
            else:
                if not args.raw:
                    print(f"[*] {status_label}")
                result = call_llm(
                    prompt=full_prompt,
                    cfg=cfg,
                    model=model,
                    use_search=use_search,
                    cmd_mode=args.cmd,
                    site=target_site or None,
                )
            set_cache(cache_key, result)
        except Exception as e:
            print(f"[-] Error: {e}", file=sys.stderr)
            sys.exit(1)

    if args.raw:
        if args.cmd and result.get("suggested_cmd"):
            print(result["suggested_cmd"])
        else:
            print(result["text"])
        return

    render_output(result, query_str, from_cache, target_site, args.no_web, model, provider)

    suggested_cmd = result.get("suggested_cmd")
    if args.cmd and suggested_cmd:
        if args.yes:
            execute_shell_command(suggested_cmd)
        elif sys.stdin.isatty():
            try:
                choice = input("Execute command? [y/N]: ").strip().lower()
                if choice == "y":
                    execute_shell_command(suggested_cmd)
            except (KeyboardInterrupt, EOFError):
                pass


if __name__ == "__main__":
    main()
