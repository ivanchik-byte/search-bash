def load_config() -> dict:
    cfg = {
        "provider": "gemini",
        "api_key": "",
        "model": "",
        "base_url": "",
        "default_site": "",
        "keys": {},
        "models": {},
    }
    # Load stored json settings if file exists
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                saved = json.load(f)
                cfg.update(saved)
        except Exception:
            pass

    # Environment variables take precedence over config file
    env_key = os.environ.get("GEMINI_API_KEY") or os.environ.get("OPENROUTER_API_KEY") or os.environ.get("OPENAI_API_KEY")
    if env_key and not cfg.get("api_key"):
        cfg["api_key"] = env_key.strip()
    if os.environ.get("SEARCH_PROVIDER"):
        cfg["provider"] = os.environ.get("SEARCH_PROVIDER").strip()
    if os.environ.get("SEARCH_MODEL"):
        cfg["model"] = os.environ.get("SEARCH_MODEL").strip()

    provider = cfg.get("provider", "gemini")
    p_meta = PROVIDERS.get(provider, PROVIDERS["gemini"])

    # Fill defaults for provider if not customized
    if not cfg.get("model"):
        cfg["model"] = cfg.get("models", {}).get(provider) or p_meta["default_model"]
    if not cfg.get("base_url"):
        cfg["base_url"] = p_meta["base_url"]
    if not cfg.get("api_key") and cfg.get("keys", {}).get(provider):
        cfg["api_key"] = cfg["keys"][provider]

    return cfg


def save_config(provider: str = None, api_key: str = None, model: str = None, base_url: str = None, default_site: str = None):
    # Lock down directory permissions (rwx------)
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    try:
        CONFIG_DIR.chmod(0o700)
    except Exception:
        pass
    current = load_config()

    if provider is not None:
        current["provider"] = provider.strip()
    active_p = current.get("provider", "gemini")

    if "keys" not in current:
        current["keys"] = {}
    if "models" not in current:
        current["models"] = {}

    # Store credentials per-provider so switching providers doesn't erase them
    if api_key is not None:
        current["api_key"] = api_key.strip()
        current["keys"][active_p] = api_key.strip()
    if model is not None:
        current["model"] = model.strip()
        current["models"][active_p] = model.strip()
    if base_url is not None:
        current["base_url"] = base_url.strip()
    if default_site is not None:
        current["default_site"] = default_site.strip()

    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(current, f, indent=2, ensure_ascii=False)
    # File restricted to owner read/write (rw-------)
    try:
        CONFIG_FILE.chmod(0o600)
    except Exception:
        pass


# Minimal HTTP client using standard urllib to avoid third-party dependencies
def http_request(url: str, method: str = "GET", data: dict = None, headers: dict = None, timeout: float = 60.0) -> dict:
    h = {"User-Agent": f"search-cli/{VERSION}"}
    if headers:
        h.update(headers)
    body = None
    if data is not None:
        body = json.dumps(data).encode("utf-8")
        h["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=body, headers=h, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", errors="replace")
        # Scrub API keys so they never leak into error logs
        raw = re.sub(r"key=[A-Za-z0-9_\-\.]+", "key=[REDACTED]", raw)
        msg = f"HTTP {e.code}"
        # Extract provider-specific error message if available
        try:
            err_json = json.loads(raw)
            if "error" in err_json:
                err_obj = err_json["error"]
                if isinstance(err_obj, dict) and "message" in err_obj:
                    msg = f"{msg}: {err_obj['message']}"
                else:
                    msg = f"{msg}: {err_obj}"
            else:
                msg = f"{msg}: {raw}"
        except Exception:
            msg = f"{msg}: {raw}"
        raise RuntimeError(msg)
    except Exception as e:
        err_str = re.sub(r"key=[A-Za-z0-9_\-\.]+", "key=[REDACTED]", str(e))
        if "timed out" in err_str.lower():
            err_str = f"{err_str} (server response exceeded timeout of {int(timeout)}s)"
        raise RuntimeError(f"Network error: {err_str}")


# Quick probe to test key before saving to config
def validate_provider_key(provider: str, api_key: str, base_url: str = None) -> tuple[bool, str]:
    if not base_url:
        base_url = PROVIDERS.get(provider, {}).get("base_url", "")

    try:
        if provider == "gemini":
            url = f"{base_url}/models?key={api_key}"
            data = http_request(url, method="GET", timeout=10.0)
            if "models" in data:
                return True, ""
            return False, "Unexpected response format from Gemini API"
        else:
            url = f"{base_url.rstrip('/')}/models"
            headers = {"Authorization": f"Bearer {api_key}"}
            http_request(url, method="GET", headers=headers, timeout=10.0)
            return True, ""
    except Exception as e:
        return False, str(e)


# First-run or manual interactive setup wizard
def prompt_setup() -> dict:
    print("\n=== Search CLI Setup ===")
    print("Select API Provider:")
    print("  [1] Google Gemini (Google AI Studio - 1500 free queries/day)")
    print("  [2] OpenRouter (openrouter.ai - access to 200+ models)")
    print("  [3] Nvidia NIM (integrate.api.nvidia.com - fast LLMs)")
    print("  [4] Custom OpenAI-compatible (Ollama, Groq, vLLM, local server)")

    if not sys.stdin.isatty():
        print("[-] Non-interactive environment. Run 'search --set-key <KEY>'.", file=sys.stderr)
        sys.exit(1)

    choice = input("\nChoice [1-4, default 1]: ").strip()
    p_map = {"1": "gemini", "2": "openrouter", "3": "nvidia", "4": "custom"}
    provider = p_map.get(choice, "gemini")
    p_info = PROVIDERS[provider]

    base_url = p_info["base_url"]
    if provider == "custom":
        url_in = input(f"Enter Base URL [default: {base_url}]: ").strip()
        if url_in:
            base_url = url_in

    if p_info["key_url"]:
        print(f"[*] Get your API key at: {p_info['key_url']}")

    while True:
        try:
            # getpass keeps key hidden from screen and bash history
            raw_key = getpass.getpass(f"Enter {p_info['name']} API key (input hidden): ").strip().strip("'\"")
        except (KeyboardInterrupt, EOFError):
            print("\nAborted.")
            sys.exit(1)

        if not raw_key:
            if provider == "custom":
                raw_key = "none"
                break
            continue

        print(f"[*] Validating key against {p_info['name']}...")
        valid, err = validate_provider_key(provider, raw_key, base_url)
        if not valid:
            print(f"[-] Validation note: {err}")
            save_anyway = input("Do you want to save this key anyway? [y/N]: ").strip().lower()
            if save_anyway == "y":
                break
            retry = input("Try another key? [Y/n]: ").strip().lower()
            if retry == "n":
                sys.exit(1)
            continue

        print(f"[+] Key validated successfully!")
        break

    if provider == "gemini":
        print("\n[*] Note: gemini-3.5-flash-lite provides live Google Search and fastest speed,")
        print("    but has lighter reasoning. For complex code/architecture, gemini-3.6-flash is recommended.")
        print("    Options: gemini-3.5-flash-lite (fast), gemini-3.6-flash (smarter)")

    model = p_info["default_model"]
    model_in = input(f"Model [default: {model}]: ").strip()
    if model_in:
        model = model_in

    save_config(provider=provider, api_key=raw_key, model=model, base_url=base_url)
    print(f"[+] Configuration saved to ~/.config/search/config.json\n")
    return load_config()


def ensure_key() -> dict:
    cfg = load_config()
    if not cfg.get("api_key"):
        return prompt_setup()
    return cfg


# Wipe cached query responses from ~/.cache/search_cli
def clear_cache() -> int:
    if not CACHE_DIR.exists():
        return 0
    count = 0
    for p in CACHE_DIR.glob("*.json"):
        try:
            p.unlink()
            count += 1
        except Exception:
            pass
    return count


# Look up cached response using sha256 of the prompt and options
def get_cache(key_str: str) -> dict | None:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    q_hash = hashlib.sha256(key_str.encode("utf-8")).hexdigest()
    cache_file = CACHE_DIR / f"{q_hash}.json"
    if cache_file.exists():
        try:
            with open(cache_file, "r", encoding="utf-8") as f:
                data = json.load(f)
            if time.time() - data.get("timestamp", 0) < CACHE_TTL:
                return data.get("result")
        except Exception:
            pass
    return None


def set_cache(key_str: str, result: dict):
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        q_hash = hashlib.sha256(key_str.encode("utf-8")).hexdigest()
        cache_file = CACHE_DIR / f"{q_hash}.json"
        with open(cache_file, "w", encoding="utf-8") as f:
            json.dump({"timestamp": time.time(), "result": result}, f, ensure_ascii=False)
    except Exception:
        pass


# Slurp stdin only if data is actually piped (avoids blocking interactive runs)
def read_piped_stdin() -> str:
    if sys.stdin.isatty():
        return ""
    try:
        raw_data = sys.stdin.buffer.read(MAX_STDIN_BYTES + 1)
        if len(raw_data) > MAX_STDIN_BYTES:
            print(f"[-] Warning: stdin truncated to {MAX_STDIN_BYTES // 1024 // 1024}MB.", file=sys.stderr)
            raw_data = raw_data[:MAX_STDIN_BYTES]
        return raw_data.decode("utf-8", errors="replace").strip()
    except Exception as e:
        print(f"[-] Warning: failed to read stdin: {e}", file=sys.stderr)
        return ""


# Convert raw bytes into readable sizes (KB, MB, GB)
def format_size(size_bytes: int) -> str:
    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if abs(size_bytes) < 1024.0 or unit == "TB":
            return f"{size_bytes:.1f} {unit}" if unit != "B" else f"{size_bytes} B"
        size_bytes /= 1024.0
    return f"{size_bytes:.1f} PB"


# Show file modification date plus relative age (e.g. 2h ago, 5d ago)
def format_mtime(timestamp: float) -> str:
    dt = time.localtime(timestamp)
    date_str = time.strftime("%Y-%m-%d", dt)
    diff_sec = time.time() - timestamp
    if diff_sec < 3600:
        age_str = f"{int(diff_sec // 60)}m ago" if diff_sec >= 60 else "just now"
    elif diff_sec < 86400:
        age_str = f"{int(diff_sec // 3600)}h ago"
    else:
        days = int(diff_sec // 86400)
        age_str = f"{days}d ago"
    return f"{date_str} ({age_str})"


# Sum up folder size without listing every child file
def get_dir_summary(path: Path) -> tuple[int, int]:
    total_size = 0
    total_count = 0
    try:
        for root, _, files in os.walk(path):
            for f in files:
                try:
                    fp = os.path.join(root, f)
                    total_size += os.path.getsize(fp)
                    total_count += 1
                except (OSError, PermissionError):
                    pass
    except Exception:
        pass
    return total_size, total_count


# Null bytes signal binary content; skip to protect LLM context
def is_binary_file(path: Path) -> bool:
    try:
        with open(path, "rb") as f:
            chunk = f.read(1024)
            return b"\x00" in chunk
    except Exception:
        return False


# Read file with size limits; auto-tails logs or samples head of large files
def read_file_context(file_spec: str | Path, max_sample_bytes: int = MAX_FILE_BYTES) -> str:
    raw_spec = str(file_spec)
    slice_mode = None
    slice_lines = 100

    # Parse optional slice syntax like file.log:tail:50
    if ":" in raw_spec and not Path(raw_spec).exists():
        parts = raw_spec.split(":")
        raw_spec = parts[0]
        slice_mode = parts[1].lower()
        if len(parts) > 2 and parts[2].isdigit():
            slice_lines = int(parts[2])

    p = Path(raw_spec).expanduser().resolve()
    if not p.exists() or not p.is_file():
        raise FileNotFoundError(f"File not found: {raw_spec}")

    size = p.stat().st_size
    mtime = p.stat().st_mtime
    meta_info = f"File: {p.name} | Size: {format_size(size)} | Mod: {format_mtime(mtime)}\nPath: {p}"

    if is_binary_file(p):
        return f"{meta_info}\n[Binary file - preview omitted]"

    # For logs, the tail has the crash info we actually care about
    is_log = p.suffix.lower() in {".log", ".out", ".err", ".trace", ".dump"}
    if slice_mode == "tail" or (is_log and size > max_sample_bytes):
        with open(p, "rb") as f:
            read_bytes = min(size, 64 * 1024)
            f.seek(max(0, size - read_bytes))
            content = f.read().decode("utf-8", errors="replace")
            lines = content.splitlines()[-slice_lines:]
            content = "\n".join(lines)
        return f"{meta_info} (Sampled TAIL: last {len(lines)} lines):\n```\n{content}\n```"

    # For big text files, take head to stay within prompt budget
    if size > max_sample_bytes:
        with open(p, "rb") as f:
            content = f.read(max_sample_bytes).decode("utf-8", errors="replace")
        return f"{meta_info} (Sampled HEAD: first {max_sample_bytes // 1024}KB):\n```\n{content}\n```"

    content = p.read_text(encoding="utf-8", errors="replace")
    return f"{meta_info}\n```\n{content}\n```"


# Recursive directory tree generator with size and age metadata
def scan_directory(dir_path: str, max_depth: int = 3, max_files: int = 200) -> str:
    root = Path(dir_path).expanduser().resolve()
    if not root.exists() or not root.is_dir():
        raise FileNotFoundError(f"Directory not found: {dir_path}")

    all_files: list[dict] = []
    tree_lines = [f"{root.name}/"]
    file_count = 0
    total_scanned_bytes = 0
    important_previews = []

    def walk(current: Path, prefix: str, depth: int):
        nonlocal file_count, total_scanned_bytes
        if depth > max_depth or file_count >= max_files:
            return

        try:
            entries = sorted(list(current.iterdir()), key=lambda x: (x.is_file(), x.name.lower()))
        except PermissionError:
            return

        # Skip hidden files and dot-folders by default
        visible = [e for e in entries if not e.name.startswith(".")]

        for idx, entry in enumerate(visible):
            if file_count >= max_files:
                tree_lines.append(f"{prefix}... [limit of {max_files} files reached]")
                break

            is_last = idx == len(visible) - 1
            connector = "\\-- " if is_last else "|-- "
            sub_prefix = "    " if is_last else "|   "

            if entry.is_dir():
                # Summarize heavy dependency directories instead of traversing
                if entry.name in IGNORED_DIRS:
                    d_size, d_cnt = get_dir_summary(entry)
                    tree_lines.append(f"{prefix}{connector}{entry.name}/ [{format_size(d_size)} | {d_cnt} files (collapsed)]")
                    total_scanned_bytes += d_size
                    continue

                tree_lines.append(f"{prefix}{connector}{entry.name}/")
                walk(entry, prefix + sub_prefix, depth + 1)
            else:
                try:
                    st = entry.stat()
                    size = st.st_size
                    mtime = st.st_mtime
                except OSError:
                    size, mtime = 0, 0

                file_count += 1
                total_scanned_bytes += size
                rel_path = str(entry.relative_to(root)) if entry.is_relative_to(root) else entry.name
                all_files.append({
                    "path": rel_path,
                    "full_path": str(entry),
                    "size": size,
                    "mtime": mtime,
                    "name": entry.name
                })

                size_meta = f"[{format_size(size)} | {format_mtime(mtime)}]"
                tree_lines.append(f"{prefix}{connector}{entry.name} {size_meta}")

                # Peek at primary project files for context
                if entry.name.lower() in {
                    "readme.md", "pyproject.toml", "package.json", "cargo.toml",
                    "go.mod", "dockerfile", "docker-compose.yml", "makefile"
                } and len(important_previews) < 2:
                    try:
                        content = entry.read_text(encoding="utf-8", errors="replace")[:1200]
                        important_previews.append(f"--- Preview: {entry.name} ---\n{content}")
                    except Exception:
                        pass

    walk(root, "", 1)

    # Sort largest files so the LLM spots cleanup targets right away
    top_files = sorted(all_files, key=lambda x: x["size"], reverse=True)[:10]
    for f in top_files:
        if f["full_path"] not in LAST_SCANNED_CANDIDATES:
            LAST_SCANNED_CANDIDATES.append(f["full_path"])
    top_summary = []
    for rank, f in enumerate(top_files, 1):
        top_summary.append(
            f"  [{rank:2d}] {format_size(f['size']):>10} | {format_mtime(f['mtime'])} | {f['path']}"
        )

    header = [
        f"Directory: {root}",
        f"Total Size: {format_size(total_scanned_bytes)} across {file_count} files (scanned depth: {max_depth})",
        "\nTOP LARGEST FILES (Candidates for inspection / cleanup):",
        "\n".join(top_summary) if top_summary else "  (None)",
        "\nDirectory Tree:",
        "\n".join(tree_lines)
    ]
    if important_previews:
        header.append("\n" + "\n\n".join(important_previews))

    return "\n".join(header)


# Expand globs (*.log) and comma-separated file arguments
def resolve_file_patterns(patterns: list[str]) -> list[Path]:
    resolved = []
    seen = set()
    for item in patterns:
        parts = [p.strip() for p in item.split(",") if p.strip()]
        for p_str in parts:
            if any(char in p_str for char in ["*", "?", "["]):
                matched = glob.glob(os.path.expanduser(p_str), recursive=True)
                for m in sorted(matched):
                    path = Path(m).resolve()
                    if path.is_file() and str(path) not in seen:
                        seen.add(str(path))
                        resolved.append(path)
            else:
                path = Path(p_str).expanduser().resolve()
                if path.is_file() and str(path) not in seen:
                    seen.add(str(path))
                    resolved.append(path)
                elif path.is_dir():
                    print(f"[-] Note: '{p_str}' is a directory. Use -d/--dir for directory scanning.", file=sys.stderr)
                else:
                    print(f"[-] Warning: file '{p_str}' not found.", file=sys.stderr)
    return resolved


# Pull out runnable shell command from markdown blocks, inline code, or $ prefix
def extract_shell_command(text: str) -> str | None:
    # 1. Standard markdown code block: ```bash ... ```
    match = re.search(r"```(?:bash|sh|zsh|shell)?\s*\n(.*?)\n```", text, re.DOTALL)
    if match:
        cmd = match.group(1).strip()
        active = [l for l in cmd.splitlines() if not l.strip().startswith("#")]
        if active:
            return "\n".join(active).strip()

    # 2. Any code block without newline: ```bash ... ```
    match = re.search(r"```(?:bash|sh|zsh|shell)?\s*(.*?)\s*```", text, re.DOTALL)
    if match:
        cmd = match.group(1).strip()
        active = [l for l in cmd.splitlines() if not l.strip().startswith("#")]
        if active:
            return "\n".join(active).strip()

    # 3. Lines prefixed with $
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("$ "):
            return line[2:].strip()

    # 4. Inline code block with common shell command
    inline_matches = re.findall(r"`([^`\n]+)`", text)
    common_verbs = {"rm", "gio", "trash-put", "find", "mv", "cp", "git", "docker", "ls", "cat", "sed", "awk", "tar", "grep", "curl", "chmod", "chown", "mkdir"}
    for inline in inline_matches:
        inline = inline.strip()
        first_word = inline.split()[0] if inline.split() else ""
        if first_word in common_verbs:
            return inline

    return None


# Dispatch prompt to configured backend (Gemini or OpenAI-compatible)
def call_llm(
    prompt: str,
    cfg: dict,
    model: str = None,
    use_search: bool = True,
    cmd_mode: bool = False,
    site: str = None,
) -> dict:
    provider = cfg.get("provider", "gemini")
    api_key = cfg.get("api_key", "")
    base_url = cfg.get("base_url", "")
    target_model = model or cfg.get("model") or PROVIDERS.get(provider, {}).get("default_model")

    if cmd_mode:
        sys_msg = (
            "You are a precise Linux/Unix command-line assistant. "
            "Output the exact, ready-to-execute shell command inside a single markdown code block: ```bash\n<command>\n```. "
            "Follow with a concise 1-sentence explanation. Avoid conversational filler. "
            "Rules for commands:\n"
            "- Must be a single runnable command or pipeline (never write interactive scripts with read -p).\n"
            "- When deleting or modifying files in the current folder, target the current directory directly (e.g. 'rm -i ./*.png' or 'gio trash ./*.png').\n"
            "- Never use fictional placeholders like '/path/to/your/file' when user refers to the current folder.\n"
            "- Always use safe flags for deletion (such as -i for interactive confirmation before deleting each file)."
        )
    else:
        sys_msg = (
            "You are a technical CLI assistant for developers and systems engineers. "
            "Provide concise, direct, and accurate responses. "
            "Use code blocks for commands, code snippets, or configuration examples only when relevant. "
            "Do not force dummy code blocks for greetings or general questions. "
            "When analyzing directories, codebase trees, or disk cleanup:\n"
            "1. Categorize findings into:\n"
            "   - Safe to delete immediately (old rotated logs, build artifacts, temporary caches, stale dumps).\n"
            "   - Needs inspection first ('Let me inspect this' / 'Дай мне посмотреть' - e.g. unknown configs, loose scripts, untracked data).\n"
            "   - Dangerous / preserve (source code, active configurations, database files).\n"
            "2. Justify recommendations using file sizes and ages.\n"
            "3. If uncertain about a file, explicitly advise inspecting it before deletion, referencing its path or candidate number.\n"
            "Avoid conversational fluff and emojis."
        )

    augmented_prompt = prompt
    if site:
        augmented_prompt = f"Scope search/knowledge specifically to '{site}'.\n\nQuery: {prompt}"

    # Google Gemini: URL auth + googleSearch tool grounding
    if provider == "gemini":
        url = f"{base_url}/models/{target_model}:generateContent?key={api_key}"
        payload = {
            "contents": [{"role": "user", "parts": [{"text": augmented_prompt}]}],
            "systemInstruction": {"parts": [{"text": sys_msg}]},
            "generationConfig": {"temperature": 0.2 if cmd_mode else 0.4, "maxOutputTokens": 3000},
        }
        if use_search:
            payload["tools"] = [{"googleSearch": {}}]

        try:
            data = http_request(url, method="POST", data=payload, timeout=60.0)
        except RuntimeError as e:
            fallback = PROVIDERS["gemini"].get("fallback_model")
            if "HTTP 404" in str(e) and fallback and target_model != fallback:
                print(f"[-] Model '{target_model}' not found. Retrying with '{fallback}'...", file=sys.stderr)
                return call_llm(prompt, cfg, model=fallback, use_search=use_search, cmd_mode=cmd_mode, site=site)
            raise e

        candidates = data.get("candidates", [])
        if not candidates:
            raise RuntimeError("No response candidate returned by Gemini API.")

        parts = candidates[0].get("content", {}).get("parts", [])
        text_parts = [p.get("text", "") for p in parts if "text" in p]
        answer_text = "".join(text_parts).strip()

        # Parse Gemini search citations
        grounding_meta = candidates[0].get("groundingMetadata", {})
        queries = grounding_meta.get("webSearchQueries", [])
        chunks = grounding_meta.get("groundingChunks", [])
        sources = []
        seen = set()
        for chunk in chunks:
            web = chunk.get("web", {})
            uri = web.get("uri")
            title = web.get("title", uri)
            if uri and uri not in seen:
                seen.add(uri)
                sources.append({"title": title, "url": uri})

        return {
            "text": answer_text,
            "suggested_cmd": extract_shell_command(answer_text) if cmd_mode else None,
            "queries": queries,
            "sources": sources,
            "model_used": target_model,
        }

    else:
        # Standard OpenAI chat completions (OpenRouter, Nvidia NIM, Ollama)
        url = f"{base_url.rstrip('/')}/chat/completions"
        headers = {"Authorization": f"Bearer {api_key}"}

        request_model = target_model
        payload = {
            "model": request_model,
            "messages": [
                {"role": "system", "content": sys_msg},
                {"role": "user", "content": augmented_prompt},
            ],
            "temperature": 0.2 if cmd_mode else 0.4,
            "max_tokens": 2048,
        }

        data = http_request(url, method="POST", data=payload, headers=headers, timeout=60.0)
        choices = data.get("choices", [])
        if not choices:
            raise RuntimeError(f"No choices returned by {provider} API.")

        msg = choices[0].get("message", {})
        answer_text = (msg.get("content") or msg.get("reasoning_content") or "").strip()

        # Extract citations if supported by the endpoint
        sources = []
        if "citations" in choices[0]:
            for c in choices[0]["citations"]:
                sources.append({"title": c.get("title", "Source"), "url": c.get("url", "")})

        return {
            "text": answer_text,
            "suggested_cmd": extract_shell_command(answer_text) if cmd_mode else None,
            "queries": [],
            "sources": sources,
            "model_used": target_model,
        }


# Execute command after user confirmation
def execute_shell_command(cmd: str):
    print(f"\n[+] Executing: {cmd}")
    try:
        res = subprocess.run(cmd, shell=True)
        if res.returncode != 0:
            print(f"[-] Command exited with code: {res.returncode}", file=sys.stderr)
    except Exception as e:
        print(f"[-] Execution error: {e}", file=sys.stderr)


# Format Markdown response into a clean panel or plain text fallback
def render_output(result: dict, query_str: str, from_cache: bool, target_site: str, no_web: bool, model: str, provider: str):
    if HAS_RICH:
        cache_notice = " [dim](cached)[/dim]" if from_cache else ""
        site_notice = f" [cyan]• site:{target_site}[/cyan]" if target_site else ""
        web_notice = " [green]• web[/green]" if not no_web else " [dim]• no-web[/dim]"
        title = f"[bold white]{query_str or 'Analysis'}[/bold white]{site_notice}{web_notice}{cache_notice}"

        console.print()
        console.print(Panel(
            Markdown(result["text"]),
            title=title,
            border_style="cyan",
            subtitle=f"[dim]{provider} / {result.get('model_used', model)}[/dim]",
            subtitle_align="right",
        ))

        if result.get("sources"):
            console.print("[bold cyan]Sources:[/bold cyan]")
            for idx, s in enumerate(result["sources"][:5], 1):
                console.print(f"  [{idx}] {s['title']}\n      [blue underline]{s['url']}[/blue underline]")
        console.print()
    else:
        border = "=" * 60
        print(f"\n{border}")
        print(f"Results: {query_str or 'Analysis'} ({provider}: {result.get('model_used', model)})")
        print(f"{border}\n")
        print(result["text"])
        if result.get("sources"):
            print("\nSources:")
            for idx, s in enumerate(result["sources"][:5], 1):
                print(f"  [{idx}] {s['title']} -> {s['url']}")
        print()


# Interactive loop: inspect file content and offer safe deletion
def prompt_file_inspection(cfg: dict, model: str, provider: str, base_dirs: list[Path] | None = None):
    if not sys.stdin.isatty():
        return
    while True:
        try:
            if LAST_SCANNED_CANDIDATES:
                prompt_str = f"\nInspect file content? [1-{len(LAST_SCANNED_CANDIDATES)} or file path, Enter to finish]: "
            else:
                prompt_str = "\nInspect file content? [file path, Enter to finish]: "
            target_str = console.input(f"[bold cyan]{prompt_str}[/bold cyan]").strip() if HAS_RICH else input(prompt_str).strip()
        except (KeyboardInterrupt, EOFError):
            print()
            break

        if not target_str or target_str.lower() in {"q", "quit", "exit", "n", "no"}:
            break

        clean_path_str = target_str.split()[0].strip("'\"")
        # Check if user typed a candidate rank number (e.g. 1 or #1)
        num_str = clean_path_str.lstrip("#")
        if num_str.isdigit():
            idx = int(num_str)
            if 1 <= idx <= len(LAST_SCANNED_CANDIDATES):
                clean_path_str = LAST_SCANNED_CANDIDATES[idx - 1]
            else:
                print(f"[-] Invalid candidate number: {idx}. Choose 1-{len(LAST_SCANNED_CANDIDATES)}")
                continue

        target_path = Path(clean_path_str).expanduser()
        # Resolve relative path inside scanned folder if not found in cwd
        if not target_path.is_absolute() and not target_path.exists() and base_dirs:
            for b in base_dirs:
                candidate = (b / target_path).resolve()
                if candidate.exists():
                    target_path = candidate
                    break
        target_path = target_path.resolve()
        if not target_path.exists():
            print(f"[-] File not found: {clean_path_str}")
            continue
        if target_path.is_dir():
            print(f"[-] '{clean_path_str}' is a directory. Specify a file path to inspect.")
            continue

        try:
            file_ctx = read_file_context(target_path)
        except Exception as e:
            print(f"[-] Cannot read file: {e}")
            continue

        inspection_prompt = (
            f"Context:\n{file_ctx}\n\n"
            f"Task: Inspect this file ({target_path.name}). Summarize what it contains and its role. "
            f"Determine if it is safe to delete or if it contains critical/active data. Provide a clear verdict."
        )

        try:
            with PipxSpinner(f"Inspecting {target_path.name}..."):
                res = call_llm(
                    prompt=inspection_prompt,
                    cfg=cfg,
                    model=model,
                    use_search=False,
                    cmd_mode=False
                )
            render_output(res, f"File Inspection: {target_path.name}", False, "", True, model, provider)
        except Exception as e:
            print(f"[-] Inspection error: {e}")
            continue

        # Ask user before removing; favor trash utilities over permanent rm
        try:
            del_choice = input(f"Delete '{target_path.name}'? [y/N]: ").strip().lower()
            if del_choice == "y":
                if subprocess.run("which trash-put >/dev/null 2>&1", shell=True).returncode == 0:
                    subprocess.run(["trash-put", str(target_path)])
                    print(f"[+] Moved to trash: {target_path.name}")
                elif subprocess.run("which gio >/dev/null 2>&1", shell=True).returncode == 0:
                    subprocess.run(["gio", "trash", str(target_path)])
                    print(f"[+] Moved to trash: {target_path.name}")
                else:
                    target_path.unlink()
                    print(f"[+] Deleted: {target_path.name}")
        except Exception as e:
            print(f"[-] Deletion error: {e}")


# Interactive REPL session
def run_interactive():
    cfg = ensure_key()
    provider = cfg.get("provider", "gemini")

    if HAS_RICH:
        console.print(Panel(
            f"[bold white]Search CLI[/bold white] [dim]v{VERSION}[/dim]\n"
            f"[dim]Provider: {PROVIDERS.get(provider, {}).get('name', provider)} | Model: {cfg.get('model')}[/dim]",
            border_style="cyan"
        ))
    else:
        print(f"=== Search CLI v{VERSION} ({provider}) ===")

    while True:
        try:
            prompt_str = "\nQuery (or 'q' to exit): "
            query = console.input(f"[bold cyan]{prompt_str}[/bold cyan]").strip() if HAS_RICH else input(prompt_str).strip()
        except (KeyboardInterrupt, EOFError):
            print("\nExiting.")
            break

        if not query or query.lower() in {"q", "exit", "quit"}:
            break

        default_site = cfg.get("default_site", "")
        site_msg = f"Target domain (default: {default_site}): " if default_site else "Target domain (optional, e.g. stackoverflow.com): "
        site_in = (console.input(f"[dim]{site_msg}[/dim]") if HAS_RICH else input(site_msg)).strip()
        target_site = site_in if site_in else default_site

        ctx_msg = "File or dir context (optional, press Enter to skip): "
        ctx_in = (console.input(f"[dim]{ctx_msg}[/dim]") if HAS_RICH else input(ctx_msg)).strip()
        context_data = ""
        if ctx_in:
            ctx_path = Path(ctx_in).expanduser()
            if ctx_path.is_file():
                try:
                    context_data = read_file_context(str(ctx_path))
                except Exception as e:
                    print(f"[-] File error: {e}")
            elif ctx_path.is_dir():
                try:
                    context_data = scan_directory(str(ctx_path))
                except Exception as e:
                    print(f"[-] Directory error: {e}")
            else:
                print(f"[-] Path not found: {ctx_in}")

        mode_msg = "Mode: [1] Search & Explain  [2] Shell Command Generator: "
        mode_in = (console.input(f"[dim]{mode_msg}[/dim]") if HAS_RICH else input(mode_msg)).strip()
        cmd_mode = mode_in == "2"

        full_prompt = query
        if context_data:
            full_prompt = f"Context:\n{context_data}\n\nTask:\n{query}"

        model = cfg.get("model")
        label = "Generating command..." if cmd_mode else f"Querying ({provider}: {model})..."

        try:
            with PipxSpinner(label):
                result = call_llm(
                    prompt=full_prompt,
                    cfg=cfg,
                    model=model,
                    use_search=True,
                    cmd_mode=cmd_mode,
                    site=target_site or None,
                )
        except Exception as e:
            print(f"[-] API error: {e}")
            continue

        render_output(result, query, False, target_site, False, model, provider)

        suggested_cmd = result.get("suggested_cmd")
        if suggested_cmd and sys.stdin.isatty():
            try:
                choice = input("Execute suggested command? [y/N/e(dit)]: ").strip().lower()
                if choice == "y":
                    execute_shell_command(suggested_cmd)
                elif choice == "e":
                    edited = input("Edit command: ").strip()
                    if edited:
                        execute_shell_command(edited)
            except (KeyboardInterrupt, EOFError):
                pass

        if context_data and sys.stdin.isatty():
            prompt_file_inspection(cfg, model, provider)


def main():
    parser = argparse.ArgumentParser(
        prog="search",
        description="Terminal search, codebase inspection, and multi-provider AI assistant.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  search "how to configure reverse proxy in nginx"
  search -c "find files larger than 50MB and sort by size"
  search -p openrouter -m meta-llama/llama-3.3-70b-instruct "explain b-trees"
  search -p nvidia -m nvidia/nemotron-3.5-lightning-30b-a3b "optimize cuda kernel"
  search -s stackoverflow.com "python typeerror unhashable type"
  search -f ./nginx.conf "explain ssl configuration"
  search -d . "summarize project architecture"
  cat /var/log/syslog | search "identify root cause"
  search --setup
"""
    )
    parser.add_argument("query", nargs="*", help="Query or prompt to process")
    parser.add_argument("-c", "--cmd", action="store_true", help="Generate an executable shell command")
    parser.add_argument("-p", "--provider", choices=["gemini", "openrouter", "nvidia", "custom"], help="AI provider")
    parser.add_argument("-m", "--model", metavar="NAME", help="Model identifier")
    parser.add_argument("-s", "--site", metavar="DOMAIN", help="Scope search to a specific domain")
    parser.add_argument("-f", "--file", action="append", default=[], metavar="PATH", help="Attach file(s) or glob pattern (e.g. '*.log') as context (can be repeated)")
    parser.add_argument("-d", "--dir", action="append", default=[], metavar="PATH", help="Attach directory tree(s) as context (can be repeated)")
    parser.add_argument("-a", "--all-files", "--cwd", action="store_true", help="Attach current directory overview as context")
    parser.add_argument("-i", "--interactive", action="store_true", help="Launch interactive wizard/prompt")
    parser.add_argument("-w", "--no-web", action="store_true", help="Disable web search grounding")
    parser.add_argument("-r", "--raw", action="store_true", help="Output plain unformatted text")
    parser.add_argument("-y", "--yes", action="store_true", help="Auto-execute generated command without confirmation")
    parser.add_argument("--setup", action="store_true", help="Run provider and key configuration wizard")
    parser.add_argument("--no-cache", action="store_true", help="Bypass local cache")
    parser.add_argument("--clear-cache", action="store_true", help="Clear local cache")
    parser.add_argument("--set-provider", choices=["gemini", "openrouter", "nvidia", "custom"], help="Set default provider")
    parser.add_argument("--set-key", metavar="KEY", nargs="?", const="", help="Save API key (prompts securely without echo if KEY is omitted)")
    parser.add_argument("--set-model", metavar="MODEL", help="Save default model for active provider")
    parser.add_argument("--set-url", metavar="URL", help="Save custom Base URL")
    parser.add_argument("--set-site", metavar="DOMAIN", help="Save default search domain")
    parser.add_argument("--force", action="store_true", help="Force save settings even if key validation returns a warning")
    parser.add_argument("-v", "--version", action="version", version=f"%(prog)s {VERSION}")

    args = parser.parse_args()

    if args.setup:
        prompt_setup()
        return

    if args.clear_cache:
        cleared = clear_cache()
        print(f"[+] Cache cleared ({cleared} records removed).")
        return

    if args.set_provider:
        save_config(provider=args.set_provider)
        print(f"[+] Active provider set to: {args.set_provider}")
        return

    if args.set_url:
        save_config(base_url=args.set_url)
        print(f"[+] Base URL set to: {args.set_url}")
        return

    if args.set_model:
        save_config(model=args.set_model)
        print(f"[+] Default model set to: {args.set_model}")
        return

    if args.set_site:
        save_config(default_site=args.set_site)
        print(f"[+] Default search domain set to: {args.set_site}")
        return

    # Save API key; prompts with getpass if argument was omitted
    if args.set_key is not None:
        cfg = load_config()
        prov = args.provider or cfg.get("provider", "gemini")
        b_url = args.set_url or cfg.get("base_url")
        key_val = args.set_key.strip().strip("'\"")
        if not key_val:
            if not sys.stdin.isatty():
                print("[-] Cannot prompt in non-interactive environment. Provide KEY argument.", file=sys.stderr)
                sys.exit(1)
            try:
                key_val = getpass.getpass(f"Enter API key for {prov} (input hidden): ").strip().strip("'\"")
            except (KeyboardInterrupt, EOFError):
                print("\nAborted.")
                sys.exit(1)
            if not key_val:
                print("[-] No key entered. Aborting.", file=sys.stderr)
                sys.exit(1)

        valid, err = validate_provider_key(prov, key_val, b_url)
        if not valid and not args.force:
            print(f"[-] Key validation failed for {prov}: {err}", file=sys.stderr)
            print("    Use --force to save the key anyway if your network requires a proxy/VPN.", file=sys.stderr)
            sys.exit(1)
        save_config(provider=prov, api_key=key_val)
        print(f"[+] API key saved securely for provider '{prov}'.")
        return

    piped_data = read_piped_stdin()
    query_str = " ".join(args.query).strip()
    has_context_args = bool(args.file or args.dir or args.all_files)

    # Launch interactive wizard when called with zero input or explicit -i
    if args.interactive or (not query_str and not piped_data and not has_context_args):
        if not sys.stdin.isatty():
            parser.print_help()
            sys.exit(0)
        run_interactive()
        return

    cfg = ensure_key()
    if args.provider:
        cfg["provider"] = args.provider
        if not args.model and cfg["provider"] in PROVIDERS:
            cfg["model"] = PROVIDERS[cfg["provider"]]["default_model"]
        if cfg.get("keys", {}).get(args.provider):
            cfg["api_key"] = cfg["keys"][args.provider]

    model = args.model or cfg.get("model")
    provider = cfg.get("provider", "gemini")
    target_site = args.site or cfg.get("default_site", "")

    # Gather context chunks from pipe, directories, and file globs
    contexts = []
    active_dirs = []
    if piped_data:
        contexts.append(f"Input Stream / Log:\n```\n{piped_data}\n```")

    if args.all_files:
        active_dirs.append(Path(".").resolve())
        try:
            contexts.append(scan_directory("."))
        except Exception as e:
            print(f"[-] Directory error: {e}", file=sys.stderr)
            sys.exit(1)

    if args.dir:
        for d_path in args.dir:
            active_dirs.append(Path(d_path).expanduser().resolve())
            try:
                contexts.append(scan_directory(d_path))
            except Exception as e:
                print(f"[-] Directory error ({d_path}): {e}", file=sys.stderr)
                sys.exit(1)

    if args.file:
        matched_files = resolve_file_patterns(args.file)
        if not matched_files:
            print("[-] No matching files found.", file=sys.stderr)
            sys.exit(1)
        for mf in matched_files:
            if str(mf) not in LAST_SCANNED_CANDIDATES:
                LAST_SCANNED_CANDIDATES.append(str(mf))
        TOTAL_FILE_BUDGET = 2 * 1024 * 1024
        used_bytes = 0
        for f in matched_files:
            if used_bytes >= TOTAL_FILE_BUDGET:
                contexts.append(f"[-] {len(matched_files) - len(contexts)} remaining files omitted (context limit reached).")
                break
            try:
                ctx = read_file_context(f)
                contexts.append(ctx)
                used_bytes += len(ctx.encode("utf-8"))
            except Exception as e:
                print(f"[-] File error ({f.name}): {e}", file=sys.stderr)

    # Build prompt: if scanning dirs with no query, default to cleanup guidance
    if contexts and query_str:
        full_prompt = f"Context:\n" + "\n\n".join(contexts) + f"\n\nRequest:\n{query_str}"
    elif contexts and not query_str:
        if args.dir or args.all_files:
            full_prompt = (
                "Analyze this directory structure and top files. Summarize the contents, identify large files, "
                "obsolete logs, caches, temporary files, or candidates for cleanup, and provide clear recommendations:\n\n"
                + "\n\n".join(contexts)
            )
        else:
            full_prompt = (
                "Analyze the provided context data. Identify any errors, warnings, or anomalies, "
                "explain root causes, and provide actionable next steps and commands:\n\n" + "\n\n".join(contexts)
            )
    else:
        if args.cmd:
            cwd = Path.cwd()
            exts = re.findall(r"\.([a-zA-Z0-9_-]{1,8})\b", query_str)
            found_files = []
            for ext in exts:
                try:
                    for p in cwd.glob(f"*.{ext}"):
                        if p.is_file():
                            found_files.append(p.name)
                except Exception:
                    pass
            dir_hint = f"Current working directory: {cwd}"
            if found_files:
                dir_hint += f"\nExisting matching files in this directory: {', '.join(found_files[:15])}"
            full_prompt = f"{dir_hint}\n\nTask:\n{query_str}"
        else:
            full_prompt = query_str

    # Skip API request if response is already cached locally
    cache_key = f"{provider}:{model}:{not args.no_web}:{args.cmd}:{target_site}:{full_prompt}"
    from_cache = False
    result = None

    if not args.no_cache:
        cached_result = get_cache(cache_key)
        if cached_result:
            result = cached_result
            from_cache = True

    if result is None:
        use_search = not args.no_web
        status_label = "Generating command..." if args.cmd else f"Querying ({provider}: {model})..."

        try:
            if not args.raw:
                with PipxSpinner(status_label):
                    result = call_llm(
                        prompt=full_prompt,
                        cfg=cfg,
                        model=model,
                        use_search=use_search,
                        cmd_mode=args.cmd,
                        site=target_site or None,
                    )
            else:
                result = call_llm(
                    prompt=full_prompt,
                    cfg=cfg,
                    model=model,
                    use_search=use_search,
                    cmd_mode=args.cmd,
                    site=target_site or None,
                )
            set_cache(cache_key, result)
        except Exception as e:
            print(f"[-] Error: {e}", file=sys.stderr)
            sys.exit(1)

    if args.raw:
        if args.cmd and result.get("suggested_cmd"):
            print(result["suggested_cmd"])
        else:
            print(result["text"])
        return

    render_output(result, query_str, from_cache, target_site, args.no_web, model, provider)

    # Shell command execution prompt in -c mode
    suggested_cmd = result.get("suggested_cmd")
    if args.cmd and suggested_cmd:
        if args.yes:
            execute_shell_command(suggested_cmd)
        elif sys.stdin.isatty():
            try:
                choice = input("Execute command? [y/N/e(dit)]: ").strip().lower()
                if choice == "y":
                    execute_shell_command(suggested_cmd)
                elif choice == "e":
                    new_cmd = input(f"Edit command [{suggested_cmd}]: ").strip() or suggested_cmd
                    execute_shell_command(new_cmd)
            except (KeyboardInterrupt, EOFError):
                pass
    elif args.cmd and not suggested_cmd:
        if HAS_RICH:
            console.print("[dim]Tip: You can attach files with -f <file> or inspect folders with -d .[/dim]")
        else:
            print("Tip: You can attach files with -f <file> or inspect folders with -d .")

    # Offer file inspection if context files or dirs were provided
    if (args.dir or args.all_files or args.file) and sys.stdin.isatty():
        prompt_file_inspection(cfg, model, provider, base_dirs=active_dirs)


if __name__ == "__main__":
    main()
